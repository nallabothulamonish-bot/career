# --- Database ---
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/careerpilot

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173

# --- Optional: enable real LLM-generated interview questions/feedback ---
# Leave blank to use the built-in rule-based NLP engine (no key needed).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
